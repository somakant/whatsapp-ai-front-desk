# --- Business ---
BUSINESS_NAME="Northwind Fitness Studio"
FAQ_FILE=./data/faqs.md
# Message sent when a person needs to take over (optional)
HANDOFF_MESSAGE=
# Slack/Teams/Discord/Zapier/n8n webhook that gets an alert on every hand-off (optional)
HANDOFF_WEBHOOK_URL=
# Minutes the bot stays quiet in a chat after handing off to a person
HANDOFF_MUTE_MINUTES=240

# --- AI (optional: without a key the bot answers from FAQs only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

PORT=3000
